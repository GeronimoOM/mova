{
  "name": "mova-api",
  "version": "1.0.0",
  "description": "Mova App API",
  "author": "GeronimoOM",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --debug 0.0.0.0:3001 --watch",
    "start:prod": "node --max-old-space-size=200 dist/main",
    "format": "prettier --write .",
    "lint": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@elastic/elasticsearch": "8.19.2",
    "@fastify/multipart": "10.1.0",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/graphql": "13.4.4",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mercurius": "13.4.4",
    "@nestjs/platform-fastify": "11.1.29",
    "@nestjs/schedule": "6.1.3",
    "@sinclair/typebox": "0.34.52",
    "argon2": "0.45.1",
    "graphql": "16.14.2",
    "js-yaml": "5.3.0",
    "knex": "3.3.0",
    "luxon": "3.7.2",
    "mercurius": "^16.10.0",
    "mercurius-validation": "7.0.0",
    "mysql": "2.18.1",
    "reflect-metadata": "0.2.2",
    "stream-chain": "4.2.5",
    "uuid": "14.0.1"
  },
  "peerDependencies": {
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/js-yaml": "4.0.9",
    "@types/luxon": "3.7.4",
    "@types/stream-json": "1.7.8",
    "@types/uuid": "11.0.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
