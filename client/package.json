{
  "name": "mova-client",
  "version": "1.0.0",
  "description": "Mova App Client",
  "author": "GeronimoOM",
  "license": "UNLICENSED",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --watch",
    "start": "vite",
    "start:prod": "serve -l 4000 -s dist",
    "format": "prettier --write .",
    "lint": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "test": "cypress run --e2e",
    "test:open": "cypress open --e2e",
    "test:init": "cypress run --e2e --spec test/e2e/init.cy.ts",
    "lint-staged": "lint-staged",
    "graphql:codegen": "graphql-codegen -c ./src/api/codegen.ts",
    "pwa:assets-gen": "pwa-assets-generator --preset minimal-2023 public/images/logo.svg"
  },
  "dependencies": {
    "@apollo/client": "4.2.10",
    "@vanilla-extract/css": "1.21.2",
    "@vanilla-extract/recipes": "0.5.7",
    "classnames": "2.5.1",
    "country-flag-icons": "1.6.20",
    "dexie": "4.4.4",
    "i18next": "26.3.6",
    "i18next-http-backend": "4.0.1",
    "luxon": "3.7.2",
    "react": "19.2.8",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-icons": "5.7.0",
    "react-minimal-pie-chart": "9.1.2",
    "react-router-dom": "7.18.2",
    "rxjs": "^7.8.2",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.5",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/luxon": "3.7.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/uuid": "11.0.0",
    "@types/yamljs": "0.2.34",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "cypress": "15.20.1",
    "eslint": "10.8.1",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.9.0",
    "graphql": "17.0.2",
    "graphql-request": "7.4.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "yamljs": "0.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{html,graphql}": [
      "prettier --write"
    ]
  }
}
